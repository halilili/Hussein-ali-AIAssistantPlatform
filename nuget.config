<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-level NuGet configuration.
  Overrides machine/company settings (e.g. Package Source Mapping to an internal feed) for THIS solution only:
  every package is restored from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
