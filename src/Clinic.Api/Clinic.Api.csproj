<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Only the shared logging setup; the business system stays independent of the assistant platform (no Assistant.Core) -->
  <ItemGroup>
    <ProjectReference Include="..\Assistant.Logging\Assistant.Logging.csproj" />
  </ItemGroup>

  <!-- .NET 9 edition: keep the Microsoft.Extensions family on 9.x. A 10.x package pulls System.Diagnostics.DiagnosticSource 10
       into an ASP.NET Core 9 host → "Method not found: InstrumentAdvice`1.set_HistogramBucketBoundaries" at startup. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.*" />
    <PackageReference Include="Dapper" Version="2.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.*" />
    <PackageReference Include="Scalar.AspNetCore" Version="*" />
  </ItemGroup>

</Project>
