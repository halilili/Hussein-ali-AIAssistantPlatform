    "Ask EN insurance": {
      "commandName": "Project",
      "commandLineArgs": "--tenant clinic-haddad --ask \"do you accept insurance?\"",
      "workingDirectory": "$(ProjectDir)..\\.."
    },
    "Ask EN insurance — all scores": {
      "commandName": "Project",
      "commandLineArgs": "--tenant clinic-haddad --ask \"do you accept insurance?\" --Knowledge:MinScore 0",
