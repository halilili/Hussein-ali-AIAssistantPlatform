{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Ingest clinic-haddad": {
      "commandName": "Project",
      "commandLineArgs": "--tenant clinic-haddad --path knowledge/clinic-haddad",
      "workingDirectory": "$(ProjectDir)..\\.."
